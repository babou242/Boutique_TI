   -
     name : DeserialiseOrder
     procedure_id : 1768934134012049377
     type_code : 14
     code : |1+
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //! @param cJson (JSON)  <indiquez ici le rôle de cJson>
      //!
      //!
      
      procédure DeserialiseOrder(cJson est une chaine)
      STOrder est une Structure
      	m_IDOrder						est un entier sur 8 octets	<MAPPING=IDOrder, clé unique>
      	m_orderNumber					est une chaîne				<MAPPING=orderNumber>
      	m_orderDate						est une chaîne				<MAPPING=orderDate>
      	m_customerPurchaseOrderNumber	est une chaîne				<MAPPING=customerPurchaseOrderNumber>
      	m_purchaseOrderDate				est une chaîne				<MAPPING=purchaseOrderDate>
      	m_orderStatus					est une chaîne				<MAPPING=orderStatus>
      	m_endCustomerCompanyName		est une chaîne				<MAPPING=endCustomerCompanyName>
      FIN
      
      STOrderMessage est une Structure
      	m_IDOrderMessage	est un entier sur 8 octets	<MAPPING=IDOrderMessage, clé unique>
      	m_code				est une chaîne				<MAPPING=code>
      	m_type				est une chaîne				<MAPPING=type>
      	m_reason			est une chaîne				<MAPPING=reason>
      	m_message			est une chaîne				<MAPPING=Message>
      	m_IDOrder			est un entier sur 8 octets	<MAPPING=IDOrder>
      FIN
      
      // OrderLineItem
      STOrderLineItem est une structure
      	m_IDOrderLineItem				est un entier sur 8 octets	<mapping=IDOrderLineItem, clé unique>
      	m_tiLineItemNumber				est une chaîne				<mapping=tiLineItemNumber>
      	m_itemCheckoutProfileId			est une chaîne				<mapping=itemCheckoutProfileId>
      	m_customerLineItemNumber		est une chaîne				<mapping=customerLineItemNumber>
      	m_status						est une chaîne				<mapping=status>
      	m_cancellationWindowWeeks		est un entier				<mapping=cancellationWindowWeeks>
      	m_rescheduleWindowWeeks			est un entier				<mapping=rescheduleWindowWeeks>
      	m_nonCancellableNonReturnable	est un booléen				<mapping=nonCancellableNonReturnable>
      	m_tiPartNumber					est une chaîne				<mapping=tiPartNumber>
      	m_customerPartNumber			est une chaîne				<mapping=customerPartNumber>
      	m_tiTotalOrderItemQuantity		est un entier				<mapping=tiTotalOrderItemQuantity>
      	m_customerAnticipatedUnitPrice	est une chaîne				<mapping=customerAnticipatedUnitPrice>
      	m_quoteNumber					est une chaîne				<mapping=quoteNumber>
      	m_customerCurrencyCode			est une chaîne				<mapping=customerCurrencyCode>
      	m_tiUnitPrice					est un entier				<mapping=tiUnitPrice>
      	m_tiCurrencyCode				est une chaîne				<mapping=tiCurrencyCode>
      	m_IDOrder						est un entier sur 8 octets	<mapping=IDOrder>
      FIN
      
      // OrderLineItemSchedule
      STOrderLineItemSchedule est une structure
      	m_IDOrderLineItemSchedule	est un entier sur 8 octets	<mapping=IDOrderLineItemSchedule, clé unique>
      	m_requestedQuantity			est une chaîne				<mapping=requestedQuantity>
      	m_requestedDeliveryDate		est une chaîne				<mapping=requestedDeliveryDate>
      	m_IDOrderLineItem			est un entier sur 8 octets	<mapping=IDOrderLineItem>
      FIN
      
      
      // OrderLineItemScheduleConfirmation
      // OrderLineItemScheduleConfirmation
      STOrderLineItemScheduleConfirmation est une structure
      	m_IDOrderLineItemScheduleConfirmation	est un entier sur 8 octets	<mapping=IDOrderLineItemScheduleConfirmation, clé unique>
      	m_tiScheduleLineNumber					est une chaîne				<mapping=tiScheduleLineNumber>
      	m_scheduledQuantity						est un entier				<mapping=scheduledQuantity>
      	m_customerRequestedShipDate				est une chaîne				<mapping=customerRequestedShipDate>
      	m_estimatedShipDate						est une chaîne				<mapping=estimatedShipDate>
      	m_estimatedDeliveryDate					est une chaîne				<mapping=estimatedDeliveryDate>
      	m_estimatedDeliveryDateStatus			est une chaîne				<mapping=estimatedDeliveryDateStatus>
      	m_shippedQuantity						est un entier				<mapping=shippedQuantity>
      	m_rescheduledShipDate					est une chaîne				<mapping=rescheduledShipDate>
      	m_IDOrderLineItemSchedule				est un entier sur 8 octets	<mapping=IDOrderLineItemSchedule>
      	m_unshippedQuantity						est un entier				<mapping=unshippedQuantity>
      FIN
      
      
      		// OrderLineItemMessage
      STOrderLineItemMessage est une structure
      	m_IDOrderLineItemMessage	est un entier sur 8 octets	<mapping=IDOrderLineItemMessage, clé unique>
      	m_code						est une chaîne				<mapping=code>
      	m_type						est une chaîne				<mapping=type>
      	m_reason					est une chaîne				<mapping=reason>
      	m_message					est une chaîne				<mapping=message>
      	m_IDOrderLineItem			est un entier sur 8 octets	<mapping=IDOrderLineItem>
      FIN
      
      STRoot est une structure
      	orders est un tableau de JSON dynamiques
      fin
      
      
      vJSON est un variant = JSONVersVariant(cJson)
      
      POUR TOUT vOrder DE vJSON.orders
      	stOrder est un STOrder
      	stOrder.m_orderNumber = vOrder.orderNumber
      	stOrder.m_orderDate = vOrder.orderDate
      	stOrder.m_customerPurchaseOrderNumber = vOrder.customerPurchaseOrderNumber
      	stOrder.m_purchaseOrderDate = vOrder.purchaseOrderDate
      	stOrder.m_orderStatus = vOrder.orderStatus
      	stOrder.m_endCustomerCompanyName = vOrder.endCustomerCompanyName
      	si HLitRecherche(Order,orderNumber,stOrder.m_orderNumber) ALORS
      		Order.orderDate = stOrder.m_orderDate
      		Order.customerPurchaseOrderNumber = stOrder.m_customerPurchaseOrderNumber
      		Order.purchaseOrderDate = stOrder.m_purchaseOrderDate
      		Order.orderStatus = stOrder.m_orderStatus
      		Order.endCustomerCompanyName = stOrder.m_endCustomerCompanyName
      		HModifie(Order)
      	SINON
      
      		enregistrement_order est un Enregistrement de Order = stOrder
      		HAjoute(Order,enregistrement_order)
      	fin
      	// Purge des messages présents en base
      	HLitRecherche(OrderMessage,IDOrder,Order.IDOrder)
      	TANTQUE HTrouve()
      		HSupprime(OrderMessage)
      		HLitSuivant(OrderMessage,IDOrder)
      	FIn
      	//Ajout des messages présent dans le JSON
      	Pour tout vOrderMessage de vOrder.messages
      		stOrderMessage est un STOrderMessage
      		stOrderMessage.m_code		= vOrderMessage.code
      		stOrderMessage.m_type		= vOrderMessage.type
      		stOrderMessage.m_reason		= vOrderMessage.reason
      		stOrderMessage.m_message	= vOrderMessage.message
      		stOrderMessage.m_IDOrder	= Order.IDOrder
      		enregistrement_ordermessage est un Enregistrement de OrderMessage = stOrderMessage
      		HAjoute(OrderMessage,enregistrement_ordermessage)
      	FIN
      	tabTiPartNumber est un tableau de chaînes
      	HLitRecherche(OrderLineItem,IDOrder,Order.IDOrder)
      	TANTQUE HTrouve()
      		TableauAjoute(tabTiPartNumber,OrderLineItem.tiPartNumber)
      		HLitSuivant(OrderLineItem,IDOrder)
      	FIN
      	Trace(TableauVersChaîne(tabTiPartNumber))
      	Pour tout vOrderLineItem de vOrder.lineItems
      		cTiPartNumber est une chaîne = vOrderLineItem.tiPartNumber
      		SI TableauCherche(tabTiPartNumber,tcLinéaire,vOrderLineItem.tiPartNumber)> 0 alors
      			HLitRecherche(OrderLineItem,IDOrdertiPartNumber,[Order.IDOrder, cTiPartNumber])
      			SI HTrouve() alors
      				OrderLineItem.tiLineItemNumber				= vOrderLineItem.tiLineItemNumber
      				OrderLineItem.itemCheckoutProfileId			= vOrderLineItem.itemCheckoutProfileId
      				OrderLineItem.customerLineItemNumber		= vOrderLineItem.customerLineItemNumber
      				OrderLineItem.status						= vOrderLineItem.status
      				OrderLineItem.cancellationWindowWeeks		= vOrderLineItem.cancellationWindowWeeks
      				OrderLineItem.rescheduleWindowWeeks			= vOrderLineItem.rescheduleWindowWeeks
      				OrderLineItem.nonCancellableNonReturnable	= vOrderLineItem.nonCancellableNonReturnable
      				OrderLineItem.customerPartNumber			= vOrderLineItem.customerPartNumber
      				OrderLineItem.tiTotalOrderItemQuantity		= vOrderLineItem.tiTotalOrderItemQuantity
      				OrderLineItem.customerAnticipatedUnitPrice	= vOrderLineItem.customerAnticipatedUnitPrice
      				OrderLineItem.quoteNumber					= vOrderLineItem.quoteNumber
      				OrderLineItem.customerCurrencyCode			= vOrderLineItem.customerCurrencyCode
      				OrderLineItem.tiUnitPrice					= vOrderLineItem.tiUnitPrice
      				OrderLineItem.tiCurrencyCode				= vOrderLineItem.tiCurrencyCode
      				HModifie(OrderLineItem)
      				TableauSupprime(tabTiPartNumber,TableauCherche(tabTiPartNumber,tcLinéaire,vOrderLineItem.tiPartNumber))
      				Trace(TableauVersChaîne(tabTiPartNumber)+"Item modifié")
      
      			FIN
      		SINON
      			stOrderLineItem est un STOrderLineItem
      			stOrderLineItem.m_tiLineItemNumber				= vOrderLineItem.tiLineItemNumber
      			stOrderLineItem.m_itemCheckoutProfileId			= vOrderLineItem.itemCheckoutProfileId
      			stOrderLineItem.m_customerLineItemNumber		= vOrderLineItem.customerLineItemNumber
      			stOrderLineItem.m_status						= vOrderLineItem.status
      			stOrderLineItem.m_cancellationWindowWeeks		= vOrderLineItem.cancellationWindowWeeks
      			stOrderLineItem.m_rescheduleWindowWeeks			= vOrderLineItem.rescheduleWindowWeeks
      			stOrderLineItem.m_nonCancellableNonReturnable	= vOrderLineItem.nonCancellableNonReturnable
      			stOrderLineItem.m_tiPartNumber					= vOrderLineItem.tiPartNumber
      			stOrderLineItem.m_customerPartNumber			= vOrderLineItem.customerPartNumber
      			stOrderLineItem.m_tiTotalOrderItemQuantity		= vOrderLineItem.tiTotalOrderItemQuantity
      			stOrderLineItem.m_customerAnticipatedUnitPrice	= vOrderLineItem.customerAnticipatedUnitPrice
      			stOrderLineItem.m_quoteNumber					= vOrderLineItem.quoteNumber
      			stOrderLineItem.m_customerCurrencyCode			= vOrderLineItem.customerCurrencyCode
      			stOrderLineItem.m_tiUnitPrice					= vOrderLineItem.tiUnitPrice
      			stOrderLineItem.m_tiCurrencyCode				= vOrderLineItem.tiCurrencyCode
      			stOrderLineItem.m_IDOrder						= Order.IDOrder
      			enregistrement_orderlineitem est un Enregistrement de OrderLineItem = stOrderLineItem
      			HAjoute(OrderLineItem,enregistrement_orderlineitem)
      		FIN
      
      
      
      
      
      		Pour tout vOrderLineItemMessage de vOrderLineItem.messages
      			stOrderLineItemMessage est un STOrderLineItemMessage
      			stOrderLineItemMessage.m_code				= vOrderLineItemMessage.code
      			stOrderLineItemMessage.m_type				= vOrderLineItemMessage.type
      			stOrderLineItemMessage.m_reason				= vOrderLineItemMessage.reason
      			stOrderLineItemMessage.m_message			= vOrderLineItemMessage.message
      			stOrderLineItemMessage.m_IDOrderLineItem	= OrderLineItem.IDOrderLineItem
      			enregistrement_orderlineitemmessage est un Enregistrement de OrderLineItemMessage = stOrderLineItemMessage
      			HAjoute(OrderLineItemMessage,enregistrement_orderlineitemmessage)
      		FIN
      		pour tout vOrderLineItemSchedule de vOrderLineItem.schedules
      			stOrderLineItemSchedule est un STOrderLineItemSchedule
      			stOrderLineItemSchedule.m_requestedQuantity			= vOrderLineItemSchedule.requestedQuantity
      			stOrderLineItemSchedule.m_requestedDeliveryDate		= vOrderLineItemSchedule.requestedDeliveryDate
      			stOrderLineItemSchedule.m_IDOrderLineItem			= OrderLineItem.IDOrderLineItem
      			enregistrement_orderlineitemschedule est un Enregistrement de OrderLineItemSchedule = stOrderLineItemSchedule
      			HAjoute(OrderLineItemSchedule,enregistrement_orderlineitemschedule)
      			POUR TOUT vOrderLineItemScheduleConfirmation de vOrderLineItemSchedule.confirmations
      				stOrderLineItemScheduleConfirmation est un STOrderLineItemScheduleConfirmation
      				stOrderLineItemScheduleConfirmation.m_tiScheduleLineNumber					= vOrderLineItemScheduleConfirmation.tiScheduleLineNumber
      				stOrderLineItemScheduleConfirmation.m_scheduledQuantity						= vOrderLineItemScheduleConfirmation.scheduledQuantity
      				stOrderLineItemScheduleConfirmation.m_customerRequestedShipDate				= vOrderLineItemScheduleConfirmation.customerRequestedShipDate
      				stOrderLineItemScheduleConfirmation.m_estimatedShipDate							= vOrderLineItemScheduleConfirmation.estimatedShipDate
      				stOrderLineItemScheduleConfirmation.m_estimatedDeliveryDate						= vOrderLineItemScheduleConfirmation.estimatedDeliveryDate
      				stOrderLineItemScheduleConfirmation.m_estimatedDeliveryDateStatus				= vOrderLineItemScheduleConfirmation.estimatedDeliveryDateStatus
      				stOrderLineItemScheduleConfirmation.m_shippedQuantity							= vOrderLineItemScheduleConfirmation.shippedQuantity
      				stOrderLineItemScheduleConfirmation.m_rescheduledShipDate						= vOrderLineItemScheduleConfirmation.rescheduledShipDate
      				stOrderLineItemScheduleConfirmation.m_unshippedQuantity							= vOrderLineItemScheduleConfirmation.unshippedQuantity
      				stOrderLineItemScheduleConfirmation.m_IDOrderLineItemSchedule							= OrderLineItemSchedule.IDOrderLineItemSchedule
      				enregistrement_orderlineitemscheduleConfirmation est un Enregistrement de OrderLineItemScheduleConfirmation = stOrderLineItemScheduleConfirmation
      				HAjoute(OrderLineItemScheduleConfirmation,enregistrement_orderlineitemscheduleConfirmation)
      
      			FIN
      		FIN
      	FIN
      
      
      
      FIN
     type : 458752
