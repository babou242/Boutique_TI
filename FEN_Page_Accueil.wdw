          name : BTN_SupprimeLigne1
          identifier : 0x28512a47156ccd08
          internal_properties : 
          properties :
           x : 920
           y : 454
           width : 46
           height : 46
           anchor : 1
           anchor_ratio_size_x : 0
           accelerator_key : 65535
           tab_order : 4
          style : {}
          type : 4
          code_elements :
           type_code : 4
           p_codes :
            -
              code : |1-
               
               i			est un entier
               NbSelection	est un entier	= TABLE_ItemOrder.SelectOccurrence()
               POUR i = NbSelection À 1 PAS -1
               	TABLE_ItemOrder.Supprime(TABLE_ItemOrder.Select(i))
               FIN
               
               POUR i = 1 À TableOccurrence(TABLE_ItemOrder)
               	TABLE_ItemOrder[i].COL_CustomerLineItemNumber = i
               FIN
              type : 18
            -
              type : 161
              enabled : false
