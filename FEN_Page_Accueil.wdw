        -
          name : BTN_SupprimeLigne
          identifier : 0x282c5136098e82ba
          internal_properties : 
          properties :
           x : 915
           y : 451
           width : 46
           height : 46
           anchor : 1
           anchor_ratio_size_x : 0
           accelerator_key : 65535
           tab_order : 8
          style : {}
          type : 4
          code_elements :
           type_code : 4
           p_codes :
            -
              code : |1-
               
               i			est un entier
               NbSelection	est un entier	= TABLE_LineItem.SelectOccurrence()
               POUR i = NbSelection À 1 PAS -1
               	TABLE_LineItem.Supprime(TABLE_LineItem.Select(i))
               FIN
              type : 18
            -
              type : 161
              enabled : false
        -
          name : BTN_QuoteRequest
          identifier : 0x282b96c20e6264d4
          internal_properties : 
          properties :
           x : 410
           y : 455
           width : 143
           height : 30
           anchor : 1
           anchor_ratio_size_x : 0
           accelerator_key : 65535
           tab_order : 9
          style : {}
          type : 4
          code_elements :
           type_code : 4
           p_codes :
            -
              code : |1+
               
               
               SI PAS TokenEstValide() ALORS
               	SI PAS AutentificationAPITI() ALORS
               		Erreur("Impossible de renouveler le token API.")
               		Renvoyer Faux
               	FIN
               FIN
               
               //Vérifications avant envoi
               
               SI PAS CotationNonVide() ALORS
               	Renvoyer Faux
               FIN
               trace("fsdfgs")
               //Sérialisation des données entrées par l'utilisateur
               sJson est un Buffer = SerialisationCotation()
               Trace(sJson)
               
               sRequeteCotation est une httpRequête
               sRequeteCotation.URL						= "https://transact.ti.com/v2/backlog/quotes/test"
               sRequeteCotation.Méthode					= httpPost
               sRequeteCotation.Entête["Authorization"]	= "Bearer " +gAccessToken
               sRequeteCotation.Entête["accept"]			= "application/json"
               sRequeteCotation.Entête["Content-Type"]		= "application/json"
               sRequeteCotation.Contenu					= sJson
               
               sReponseCotation est une httpRéponse = HTTPEnvoie(sRequeteCotation)
               
               SI sReponseCotation.CodeEtat <> 200 ALORS
               	Erreur("Erreur API TI "+ sReponseCotation.CodeEtat+ sReponseCotation.Contenu)
               	RENVOYER faux
               FIN
               
               sJsonReponse est une chaîne = sReponseCotation.Contenu
               TraiterPendingQuote(sJsonReponse)
               Trace("bon")
               
              type : 18
            -
              type : 161
              enabled : false
        -
          name : BTN_AddArticle
          identifier : 0x282b91720b12a2ed
          internal_properties : 
          properties :
           x : 861
           y : 203
           width : 100
           height : 30
           accelerator_key : 65535
           tab_order : 6
          style : {}
          type : 4
          code_elements :
           type_code : 4
           p_codes :
            -
              code : |1+
               SI SAI_TiPartNumber = "" OU SAI_SeprolecPartNumber = "" OU SAI_Quantity <= 0 OU SAI_RequestedUnitPrice <= 0 alors
               	Info("Veuillez saisir toutes les informations")
               	RENVOYER FAUX
               FIN
               
               TableAjouteLigne(TABLE_LineItem,SAI_TiPartNumber,SAI_SeprolecPartNumber,SAI_Quantity,SAI_RequestedUnitPrice)
               SAI_TiPartNumber = ""
               SAI_SeprolecPartNumber = ""
               SAI_Quantity = 0
               SAI_RequestedUnitPrice = 0
               
               renvoyer VRAI
