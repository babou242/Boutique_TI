        -
          name : BTN_ValiderOrder
          identifier : 0x2863c75c1b7a0850
          internal_properties : 
          properties :
           x : 433
           y : 462
           width : 100
           height : 30
           anchor : 1
           anchor_ratio_size_x : 0
           accelerator_key : 65535
           tab_order : 5
          style : {}
          type : 4
          code_elements :
           type_code : 4
           p_codes :
            -
              code : |1-
               SI PAS TokenEstValide() ALORS
               	SI PAS AutentificationAPITI() ALORS
               		Erreur("Impossible de renouveler le token API.")
               		RENVOYER Faux
               	FIN
               FIN
               
               
               si PAS OrderNonVide() alors
               	Renvoyer Faux
               FIN
               
               sJson est un buffer = SerialisationOrder()
               
               
               sRequeteOrder est une httpRequête
               sRequeteOrder.URL						= "https://transact.ti.com/v2/backlog/orders/test"
               sRequeteOrder.Méthode					= httpPost
               sRequeteOrder.Entête["Authorization"]	= "Bearer " +gAccessToken
               sRequeteOrder.Entête["accept"]			= "application/json"
               sRequeteOrder.Entête["Content-Type"]		= "application/json"
               sRequeteOrder.Contenu					= sJson
               
               sReponseOrder est une httpRéponse = HTTPEnvoie(sRequeteOrder)
               
               SI sReponseOrder.CodeEtat <> 200 ALORS
               	Erreur("Erreur API TI "+ sReponseOrder.CodeEtat+ sReponseOrder.Contenu)
               	RENVOYER Faux
               FIN
               
               sJsonReponse est une chaîne = sReponseOrder.Contenu
               Trace(sJsonReponse)
               RENVOYER Vrai
              type : 18
            -
              type : 161
              enabled : false
        -
          name : BTN_SansNom3
          identifier : 0x2887d236a3456c71
          internal_properties : 
          properties :
           x : 476
           y : 61
           width : 100
           height : 30
           accelerator_key : 65535
           tab_order : 2
          style : {}
          type : 4
          code_elements :
           type_code : 4
           p_codes :
            -
              code : |1-
               
               
               REQ_TiPartNumberCommande.pPartNumber = COMBO_TIPartNumberOrder
               REQ_TiPartNumberCommande.pDateJour = DateSys()
               SI PAS HExécuteRequête(REQ_TiPartNumberCommande,hRequêteDéfaut) ALORS
               	Erreur(HErreurInfo())
               	RETOUR
               	FIN
               SI HNbEnr(REQ_TiPartNumberCommande) > 0 ALORS
               	HLitPremier(REQ_TiPartNumberCommande)
               	nNumLigne est un entier = TableOccurrence(TABLE_ItemOrder) + 1
               	TableAjouteLigne(TABLE_ItemOrder,REQ_TiPartNumberCommande.tiPartNumber,REQ_TiPartNumberCommande.tiUnitPrice,null,nNumLigne,"",REQ_TiPartNumberCommande.quoteNumber)
               SINON
               	Info("Aucun devis non expiré pour ce tiPartNumber.")
               FIN
              type : 18
            -
              type : 161
              enabled : false
