                  p_codes :
                   -
                     code : |1+
                      nIndex est un entier = IndiceEnCours()
                      
                      jsonPlanning est une chaîne = TABLE_ItemOrder[nIndex].COL_Schedules
                      
                      tableauPlanning est un tableau de STSchedule
                      
                      si jsonPlanning <> "" ALORS
                      	Désérialise(tableauPlanning, jsonPlanning,psdJSON)
                      SINON
                      	tableauPlanning = [] // tableau vide
                      FIN
                      // Ouvre la fenêtre modale
                      tableauPlanning = Ouvre(FEN_Schedules, tableauPlanning)
                      Sérialise(tableauPlanning,jsonPlanning,psdJSON)
                      TABLE_ItemOrder[nIndex].COL_Schedules	= jsonPlanning
                      
                      
