      -
        name : OrderNonVide
        procedure_id : 1757470501216413578
        type_code : 14
        code : |1-
         // Résumé : <indiquez ici ce que fait la procédure>
         // Syntaxe :
         // OrederNonVide ()
         //
         // Paramètres :
         //	Aucun
         // Valeur de retour :
         // 	Aucune
         //
         // Exemple :
         // <Indiquez ici un exemple d'utilisation>
         //
         procédure OrderNonVide()
         gShipToAccountNumber = ChargeParamètre("ShipToAccountNumber","")
         gCheckoutProfileId = ChargeParamètre("CheckoutProfileId","")
         
         SI SAI_CustomerPurchaseOrderNumber = "" OU gShipToAccountNumber = "" ou gCheckoutProfileId = "" ALORS
         	Info("Les champs d'information ne sont pas renseignés (Voir les paramètres)")
         	RENVOYER Faux
         FIN
         
         POUR i = 1 A TableOccurrence(TABLE_ItemOrder)
         	SI TABLE_ItemOrder.COL_CustomerAnticipatedUnitPrice[i] = "" ou
         	TABLE_ItemOrder.COL_CustomerLineItemNumber[i] = "" OU
         	TABLE_ItemOrder.COL_Schedules[i] = "" OU
         	TABLE_ItemOrder.COL_TiPartNumber = "" ALORS
         
         		Info("La ligne " + i + " a des champs vides.")
         		renvoyer Faux
         	FIN
         FIN
         renvoyer Vrai
        type : 458752
      -
        name : SerialisationOrder
        procedure_id : 1757477292483445844
        type_code : 14
        code : |1-
         // Résumé : <indiquez ici ce que fait la procédure>
         // Syntaxe :
         // SerialisationOrder ()
         //
         // Paramètres :
         //	Aucun
         // Valeur de retour :
         // 	Aucune
         //
         // Exemple :
         // <Indiquez ici un exemple d'utilisation>
         //
         procédure SerialisationOrder()
         STOrderWrapper est une Structure
         	order est un STOrderDemand
         FIN
         
         wrapper est un STOrderWrapper
         order est un STOrderDemand
         lineItems est un STLineItemOrder
         
         
         
         
         order.checkoutProfileId = gCheckoutProfileId
         order.customerPurchaseOrderNumber = SAI_CustomerPurchaseOrderNumber
         order.shipToAccountNumber = gShipToAccountNumber
         
         Dimension(order.lineItems, TableOccurrence(TABLE_ItemOrder))
         
         POUR i = 1 À TableOccurrence(TABLE_ItemOrder)
         	lineItems.tiPartNumber = TABLE_ItemOrder[i][1]
         	lineItems.customerAnticipatedUnitPrice = TABLE_ItemOrder[i][2]
         	lineItems.customerLineItemNumber = TABLE_ItemOrder[i][4]
         
         
         	lineItems.schedules = TABLE_ItemOrder[i][5]
         
         	order.lineItems[i] = lineItems
         FIN
         
         wrapper.order =order
         
         sJson est un Buffer
         Sérialise(wrapper,sJson,psdJSON)
         Trace(sJson)
         Renvoyer sJson
        type : 458752
