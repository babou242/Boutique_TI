  procedures :
   -
     name : TraiterPendingQuote
     procedure_id : 1744501082960205470
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //TraiterPendingQuote (<cJson> est chaîne)
      //
      // Paramètres :
      //	cJson (chaîne ANSI) : <indiquez ici le rôle de vJson>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure TraiterPendingQuote(cJson est une chaine)
      
      vJson est un variant = JSONVersVariant(cJson)
      tabQuotes est un Variant = vJson["quotes"]
      nQuotes est un entier = ArrayCount(tabQuotes)
      
      Pour iQuote = 1 A nQuotes
      	vQuote est un variant = tabQuotes[iQuote]
      
      
      	PendingQuote.customerQuoteNumber = vQuote.customerQuoteNumber
      	PendingQuote.quoteNumber = vQuote.quoteNumber
      	PendingQuote.quoteStatus = vQuote.quoteStatus
      	PendingQuote.quoteStartDate = vQuote.quoteStartDate
      	PendingQuote.quoteEndDate = vQuote.quoteEndDate
      
      	HAjoute(PendingQuote)
      
      	tabLineItems est un variant = vQuote["lineItems"]
      	nLineItems est un entier = ArrayCount(tabLineItems)
      
      	POUR iLineItem = 1 À nLineItems
      		vLineItem est un Variant = tabLineItems[iLineItem]
      
      		inpLocal	est une chaîne	= ""
      		tiPart		est une chaîne	= vLineItem.tiPartNumber
      
      		POUR i = 1 À TableOccurrence(TABLE_LineItem)
      			SI TABLE_LineItem[i][1] = tiPart ALORS
      				inpLocal = TABLE_LineItem[i][2] // colonne INP (supposée 4e colonne)
      				Sortir
      			FIN
      		FIN
      
      		HAjoute(PendingLineItem)
      		PendingLineItem.customerQuoteNumber	= PendingQuote.customerQuoteNumber
      		PendingLineItem.STATUS	= vLineItem.status
      		PendingLineItem.tiPartNumber		= vLineItem.tiPartNumber
      		PendingLineItem.seprolecPartNumber = inpLocal
      		HModifie(PendingLineItem)
      	FIN
      FIN
      
     type : 458752
   -
     name : PollingPendingQuote
     internal_properties : HwAAAB4AAAAIuECOTnIEJVCfAJxIpbTFt0xBb0moNBgUgUTBDFjwDKOMHPXga90MaznuwF2GCCW4vGe0Q1Jt0vYtrKmTmg52c5BUmWTpkyDxkwt7xAX1PJwF/uaKzmiYOs/pax0nqgUE
     procedure_id : 1744528609453695195
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //PollingPendingQuote ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //// Procédure automatique :
      // La procédure est exécutée manuellement, lors d'un appel dans le code
      // Elle s'exécutera dans un thread (sans avoir besoin d'appeler la fonction ThreadExecute), avec utilisation de HFSQL (copie légère du contexte)
      // Elle sera répétée en boucle, en attendant 10 secondes entre chaque appel
      //
      
      procédure PollingPendingQuote()
      Trace(">>> PollingPendingQuote appelé à " + DateVersChaîne(DateHeureSys(), "HH:MM:SS"))
      vJson est un variant
      
      
      sQuoteNumber est une chaine
      HLitPremier(PendingQuote)
      tantque HTrouve(PendingQuote)
      	sQuoteNumber = PendingQuote.customerQuoteNumber
      	SI PAS HRecherche(PendingLineItem,customerQuoteNumber,sQuoteNumber) ALORS
      		Quote.customerQuoteNumber = PendingQuote.customerQuoteNumber
      		Quote.quoteNumber = PendingQuote.quoteNumber
      		Quote.quoteStatus = PendingQuote.quoteStatus
      		Quote.quoteStartDate = PendingQuote.quoteStartDate
      		Quote.quoteEndDate = PendingQuote.quoteEndDate
      		HAjoute(Quote)
      		HSupprime(PendingQuote)
      
      		HLitSuivant(PendingQuote)
      		ExecuteMainThread(TableRefresh)
      		CONTINUER
      	FIN
      	vJson = RetrieveQuote(sQuoteNumber)
      	Trace("Retrieve")
      	HLitRecherche(PendingLineItem,customerQuoteNumber,sQuoteNumber)
      	Trace("Trouvé")
      	Tantque HTrouve(PendingLineItem)
      		si TraiterLineItem(vJson, PendingLineItem.tiPartNumber,PendingQuote.customerQuoteNumber,PendingLineItem.seprolecPartNumber) alors
      			Trace("Traitement")
      			HSupprime(PendingLineItem)
      			Trace("Suppression")
      
      		fin
      		HLitSuivant(PendingLineItem)
      	FIN
      
      	HLitSuivant(PendingQuote)
      
      FIN
      
      
      
      
      
      
     type : 458752
   -
     name : RetrieveQuote
     procedure_id : 1744801202394936048
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] RetrieveQuote (<sQuoteNumber> est chaîne)
      //
      // Paramètres :
      //	sQuoteNumber (chaîne ANSI) : <indiquez ici le rôle de sQuoteNumber>
      // Valeur de retour :
      // 	variant : <indiquez ici le rôle de la valeur de retour>
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure RetrieveQuote(sQuoteNumber est une chaine) : Variant
      SI PAS TokenEstValide() ALORS
      	SI PAS AutentificationAPITI() ALORS
      		Erreur("Impossible de renouveler le token API.")
      		Renvoyer Null
      
      	FIN
      FIN
      sRequeteRetrieveQuote est une httpRequête
      
      sRequeteRetrieveQuote.URL					= "https://transact.ti.com/v2/backlog/quotes/test?customerQuoteNumber="+sQuoteNumber
      sRequeteRetrieveQuote.Méthode					= httpGet
      sRequeteRetrieveQuote.Entête["Authorization"]	= "Bearer " + gAccessToken
      
      sReponseRetrieveQuote est une httpRéponse = HTTPEnvoie(sRequeteRetrieveQuote)
      
      SI sReponseRetrieveQuote.CodeEtat <> 200 ALORS
      	Trace("Erreur")
      	renvoyer null
      FIN
      
      sJson est une chaîne = sReponseRetrieveQuote.Contenu
      vJson est un variant = JSONVersVariant(sJson)
      renvoyer vJson
     type : 458752
   -
     name : TraiterLineItem
     procedure_id : 1745182380767869415
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] TraiterLineItem (<vJson> est variant, <tiPartNumber> est chaîne, <customerQuoteNumber> est chaîne, <seprolecPartNumber> est chaîne)
      // Paramètres :
      //	vJson (variant) : <indiquez ici le rôle de vJson>
      //	tiPartNumber (chaîne ANSI) : <indiquez ici le rôle de tiPartNumber>
      //	customerQuoteNumber (chaîne ANSI) : <indiquez ici le rôle de customerQuoteNumber>
      //	seprolecPartNumber (chaîne ANSI) : <indiquez ici le rôle de seprolecPartNumber>
      // Valeur de retour :
      // 	booléen : <indiquez ici le rôle de la valeur de retour>
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure TraiterLineItem(vJson est un variant,tiPartNumber est une chaine,customerQuoteNumber est une chaîne, seprolecPartNumber est une chaine) :booléen
      vQuote		est un Variant	= vJson.quotes[1]	// On prend la première quote
      vLineItems	est un Variant	= vQuote.lineItems
      
      nbItems est un entier = vLineItems..Occurrence
      
      POUR i = 1 À nbItems
      	vItem est un Variant = vLineItems[i]
      	SI vItem.tiPartNumber = tiPartNumber ET Pas vItem.status = "Pending" ALORS
      		LineItem.IDLineItem									= 0 // Laisse HFSQL gérer si auto-incrémenté
      		LineItem.tiLineItemNumber							= vItem.tiLineItemNumber
      		LineItem.tiUnitPrice									= vItem.tiUnitPrice
      		LineItem.tiUnitPriceCurrencyCode						= vItem.tiUnitPriceCurrencyCode
      		LineItem.tiPartNumber								= vItem.tiPartNumber
      		LineItem.quantity									= vItem.quantity
      		LineItem.requestedUnitPrice							= vItem.requestedUnitPrice
      		LineItem.requestedUnitPriceCurrencyCode				= vItem.requestedUnitPriceCurrencyCode
      		LineItem.status										= vItem.status
      		LineItem.orderLeadTime								= vItem.orderLeadTime
      		LineItem.minimumOrderQuantity						= vItem.minimumOrderQuantity
      		LineItem.nextOrderQuantityIncrement					= vItem.nextOrderQuantityIncrement
      		LineItem.packageType									= vItem.packageType
      		LineItem.restrictionOfHazardousSubstancesCompliant	= vItem.restrictionOfHazardousSubstancesCompliant
      		LineItem.nonCancellableNonReturnable					= vItem.nonCancellableNonReturnable
      		LineItem.moistureLevel								= vItem.moistureLevel
      		LineItem.exportControlClassificationNumber			= vItem.exportControlClassificationNumber
      		LineItem.paymentTerms								= vItem.paymentTerms
      		LineItem.CustomerQuoteNumber						= customerQuoteNumber
      		LineItem.seprolecPartNumber							= seprolecPartNumber
      
      
      		SI HAjoute(LineItem) = Faux ALORS
      			Erreur("Erreur lors de l'ajout du LineItem : " + HErreurInfo())
      		FIN
      		Renvoyer Vrai
      	FIN
      
      FIN
      RENVOYER Faux
      
      
      
      
     type : 458752
   -
     name : SendingQuote
     internal_properties : HwAAAB4AAABWSkc4brfW4Y/VqNYQTVKM+uWAMenNB4kPjfekQYUwCn3cmazAmVH4uHr89QoLm7IyzsnnyGOAzzJQ8TrxqXdGP9cZOUaU8FvemTZU9VW/iQtRqwFdvEH8rBn7TPhhnw==
     procedure_id : 1767255063893502926
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //SendingQuote ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //// Procédure automatique :
      // La procédure est exécutée manuellement, lors d'un appel dans le code
      // Elle s'exécutera dans un thread sécurisé (sans avoir besoin d'appeler la fonction ThreadExecute), avec utilisation de HFSQL (copie complète du contexte)
      //
      
      procédure SendingQuote()
      SI PAS TokenEstValide() ALORS
      	SI PAS AutentificationAPITI() ALORS
      		Erreur("Impossible de renouveler le token API.")
      	FIN
      FIN
      
      //Vérifications avant envoi
      
      SI CotationNonVide() ALORS
      	//Sérialisation des données entrées par l'utilisateur
      	sJson est un Buffer = SerialisationCotation()
      	Trace(sJson)
      
      	sRequeteCotation est une httpRequête
      	sRequeteCotation.URL						= "https://transact.ti.com/v2/backlog/quotes/test"
      	sRequeteCotation.Méthode					= httpPost
      	sRequeteCotation.Entête["Authorization"]	= "Bearer " +gAccessToken
      	sRequeteCotation.Entête["accept"]			= "application/json"
      	sRequeteCotation.Entête["Content-Type"]		= "application/json"
      	sRequeteCotation.Contenu					= sJson
      
      	sReponseCotation est une httpRéponse = HTTPEnvoie(sRequeteCotation)
      
      	SI sReponseCotation.CodeEtat <> 200 ALORS
      		Erreur("Erreur API TI "+ sReponseCotation.CodeEtat+ sReponseCotation.Contenu)
      	FIN
      
      	sJsonReponse est une chaîne = sReponseCotation.Contenu
      	TraiterPendingQuote(sJsonReponse)
      	Trace("bon")
      FIN
      trace("pasbon,")
      
     type : 458752
   -
     name : CotationNonVide
     procedure_id : 1767255197038240342
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] CotationNonVide ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	booléen : <indiquez ici le rôle de la valeur de retour>
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure CotationNonVide() : booléen
      gCheckoutProfileId = ChargeParamètre("CheckoutProfileId","")
      
      SI gCheckoutProfileId = "" ALORS
      	Info("L'identifiant du profil de paiement est obligatoire (voir paramètres)")
      	RENVOYER Faux
      FIN
      SI SAI_CustomerQuoteNumber = "" ALORS
      	Info("Un numéro de devis est obligatoire")
      	RENVOYER Faux
      FIN
      SI TABLE_LineItem.Occurrence() = 0 ALORS
      	Info("Veuillez ajouter au moins un article")
      	RENVOYER Faux
      FIN
      RENVOYER Vrai
      
     type : 458752
   -
     name : SerialisationCotation
     procedure_id : 1767255394615432851
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      // SerialisationCotation ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure SerialisationCotation()
      STLineItem est une Structure
      	tiPartNumber		est chaîne
      	requestedUnitPrice	est un réel
      	quantity			est un entier
      FIN
      
      STQuote est une Structure
      	endCustomerCompanyName			est une chaîne
      	customerQuoteNumber				est une chaîne
      	checkoutProfileId				est une chaîne
      	requestedUnitPriceCurrencyCode	est une chaîne
      	lineItems						est un tableau de STLineItem
      FIN
      
      STQuoteWrapper est une Structure
      	Quote est un STQuote
      FIN
      
      //Remplire une structure quote
      cotation			est un STQuote
      requestLineItem		est un STLineItem
      i					est un entier
      
      
      // Remplissage des données
      cotation.endCustomerCompanyName				= "Aria Seprolec"
      cotation.customerQuoteNumber				= SAI_CustomerQuoteNumber
      cotation.checkoutProfileId					= gCheckoutProfileId
      cotation.requestedUnitPriceCurrencyCode		= COMBO_Currency..ValeurAffichée
      
      // Initialiser le tableau des lineItems
      Dimension(cotation.lineItems, TableOccurrence(TABLE_LineItem))
      
      POUR i = 1 À TableOccurrence(TABLE_LineItem)
      	requestLineItem.tiPartNumber			= TABLE_LineItem[i][1]
      	requestLineItem.quantity				= TABLE_LineItem[i][3]
      	requestLineItem.requestedUnitPrice		= TABLE_LineItem[i][4]
      
      
      	cotation.lineItems[i]					= requestLineItem
      FIN
      
      wrapper est un STQuoteWrapper
      
      wrapper.quote = cotation
      
      sJson est un Buffer
      Sérialise(wrapper,sJson,psdJSON)
      sJson	= Remplace(sJson, "," + Caract(34) + "seprolecPartNumber" + Caract(34) + ":" + Caract(34) + "*?" + Caract(34), "")
      sJson	= Remplace(sJson, """Quote""", """quote""")
      RENVOYER sJson
     type : 458752
